#!/bin/sh
# tileception-setup: chooses which parts of the Tileception desktop to use and
# whether Tileception's own login screen replaces the current one. Asks first,
# shows a summary, then writes the answers to config.toml (through
# `tileception config`, which keeps its comments) and switches the login screen
# (with sudo). Run it again at any time to change your mind.
#
# The installers run it twice: `--print-flags` before installing asks the
# questions and prints the answers as flags, and those flags with
# `--non-interactive` apply them afterwards, so nothing is asked halfway.
#
# The greeter functions are shared with scripts/*-greeter.sh, which source this
# file with TILECEPTION_SETUP_LIB=1 so that nothing runs.

# ---------------------------------------------------------------- greeter

greeter_user=_greetd
dm_link=/etc/systemd/system/display-manager.service
# Which login screen to go back to, written when Tileception's took over.
previous_dm_file=/etc/tileception/previous-display-manager
greetd_config=/etc/greetd/config.toml
greetd_backup=/etc/greetd/config.toml.before-tileception
# greetd's PAM service with the keyring and KWallet unlocked by the login
# password, for systems whose own greetd service leaves them locked.
greetd_pam=/etc/pam.d/tileception-greetd
greetd_pam_marker="# Written by tileception-setup"

if [ "$(id -u)" -eq 0 ]; then
    as_root=""
else
    as_root=sudo
fi

# The unit that is the login screen now, such as sddm.service; empty if none.
current_dm() {
    if [ -e "$dm_link" ]; then
        basename "$(readlink -f "$dm_link")"
    fi
}

# The console greetd uses, from its config; 7 when it does not say.
greetd_vt() {
    vt=$(sed -n 's/^[[:space:]]*vt[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$greetd_config" 2>/dev/null | head -n 1)
    echo "${vt:-7}"
}

# The PAM service for logins through greetd: greetd's own, plus unlocking the
# GNOME keyring or KWallet with the password just typed (each only when
# installed; the leading "-" skips a missing module).
greetd_pam_text() {
    printf '%s\n' \
        "#%PAM-1.0" \
        "$greetd_pam_marker; greetd uses it through [general] service in" \
        "# $greetd_config. Removed again when switching back." \
        "@include greetd" \
        "-auth     optional  pam_gnome_keyring.so" \
        "-auth     optional  pam_kwallet5.so" \
        "-session  optional  pam_gnome_keyring.so auto_start" \
        "-session  optional  pam_kwallet5.so auto_start"
}

# Whether logins need greetd_pam: greetd's own service unlocks neither the
# keyring nor KWallet (Ubuntu's does, Debian's does not), and this greetd can
# use another service (0.10 and later).
needs_greetd_pam() {
    [ -e /etc/pam.d/greetd ] || return 1
    grep -qsE "pam_(gnome_keyring|kwallet)" /etc/pam.d/greetd && return 1
    version=$(dpkg-query -W -f='${Version}' greetd 2>/dev/null) || return 1
    dpkg --compare-versions "$version" ge 0.10
}

# Whether greetd runs Tileception's greeter as the login screen.
greeter_active() {
    [ "$(current_dm)" = greetd.service ] && grep -qs "tileception --greeter" "$greetd_config"
}

# Whether the package is installed, rather than a build from a checkout.
package_installed() {
    [ "$(dpkg-query -W -f='${Status}' tileception 2>/dev/null)" = "install ok installed" ]
}

# The tileception greetd's user can run: the package's, or the copy
# install-greeter.sh puts in /usr/local/bin. Empty when there is neither.
greeter_binary() {
    if package_installed; then
        echo /usr/bin/tileception
    elif [ -x /usr/local/bin/tileception ]; then
        echo /usr/local/bin/tileception
    fi
}

# Installs greetd when its user is missing. The package enables greetd, which
# takes display-manager.service; that is put back, so installing greetd never
# changes the login screen by itself.
ensure_greetd() {
    if getent passwd "$greeter_user" >/dev/null; then
        return
    fi
    if ! command -v apt-get >/dev/null; then
        echo "Install greetd with your package manager, then run this again." >&2
        exit 1
    fi
    before=$(readlink "$dm_link" || true)
    echo "Installing greetd"
    $as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y greetd </dev/null
    after=$(readlink "$dm_link" || true)
    if [ "$after" != "$before" ]; then
        $as_root systemctl disable greetd.service >/dev/null 2>&1 || true
        if [ -n "$before" ]; then
            $as_root ln -sfn "$before" "$dm_link"
        fi
        $as_root systemctl daemon-reload
    fi
    if ! getent passwd "$greeter_user" >/dev/null; then
        echo "greetd did not create its user $greeter_user; is this Debian or Ubuntu's greetd?" >&2
        exit 1
    fi
}

# Makes greetd run the greeter and the login screen from the next boot,
# remembering the one it replaces. Restarting the display manager now would
# end the graphical sessions running under it.
enable_greeter() {
    binary=$(greeter_binary)
    if [ -z "$binary" ]; then
        echo "No tileception for the login screen: install the package, or run make install-greeter from a checkout." >&2
        exit 1
    fi
    previous=$(current_dm)
    ensure_greetd
    # The package makes these when greetd is there already; greetd may be new.
    $as_root install -d -o "$greeter_user" -g "$greeter_user" -m 0700 /var/lib/tileception-greeter
    $as_root install -d -m 1733 /var/cache/tileception-greeter

    # greetd runs the greeter, on the console it already uses. Its own config
    # is kept once, for going back.
    if [ ! -e "$greetd_backup" ] && [ -e "$greetd_config" ] && ! grep -qs "tileception --greeter" "$greetd_config"; then
        $as_root cp -p "$greetd_config" "$greetd_backup"
    fi
    general=""
    if needs_greetd_pam; then
        tmp_pam=$(mktemp)
        greetd_pam_text > "$tmp_pam"
        # A service someone changed is theirs: keep it.
        if [ ! -e "$greetd_pam" ] || grep -qs "^$greetd_pam_marker" "$greetd_pam"; then
            $as_root install -m 644 "$tmp_pam" "$greetd_pam"
        fi
        rm -f "$tmp_pam"
        general="[general]
service = \"tileception-greetd\"

"
        echo "Logging in unlocks the keyring (PAM service tileception-greetd)"
    fi
    tmp_config=$(mktemp)
    printf '%s\n' \
        "# Written by tileception-setup; the previous config is" \
        "# $greetd_backup." \
        "$general[terminal]" \
        "vt = $(greetd_vt)" \
        "" \
        "[default_session]" \
        "command = \"$binary --greeter\"" \
        "user = \"$greeter_user\"" > "$tmp_config"
    $as_root install -D -m 644 "$tmp_config" "$greetd_config"
    rm -f "$tmp_config"
    echo "greetd runs the Tileception greeter"

    if [ "$previous" = greetd.service ]; then
        echo "greetd is already the login screen"
    else
        if [ -n "$previous" ]; then
            $as_root mkdir -p "$(dirname "$previous_dm_file")"
            echo "$previous" | $as_root tee "$previous_dm_file" >/dev/null
            $as_root systemctl disable "$previous"
        fi
        $as_root systemctl enable greetd.service
        echo "greetd replaces ${previous:-no login screen} as the login screen from the next boot"
    fi
}

# Switches back to the login screen enable_greeter replaced and restores
# greetd's own config; takes effect at the next boot.
restore_login_screen() {
    if grep -qs "tileception --greeter" "$greetd_config"; then
        previous=$(cat "$previous_dm_file" 2>/dev/null || true)
        if [ "$(current_dm)" = greetd.service ]; then
            if [ -z "$previous" ]; then
                if [ ! -e "$greetd_backup" ]; then
                    echo "greetd runs the Tileception greeter, and there is no earlier login screen to go back to." >&2
                    echo "Enable another one first, such as: sudo systemctl enable --force sddm" >&2
                    exit 1
                fi
                # greetd was already the display manager: keep it enabled
                # and restore the greeter it ran before Tileception.
            else
                $as_root systemctl disable greetd.service
                $as_root systemctl enable "$previous"
                echo "$previous is the login screen again from the next boot"
            fi
        fi
        if [ -e "$greetd_backup" ]; then
            $as_root mv "$greetd_backup" "$greetd_config"
            echo "Restored greetd's own config"
        fi
    fi
    $as_root rm -f "$previous_dm_file"
    # Unused once greetd's own config is back; kept if someone changed it.
    if [ -e "$greetd_pam" ] && ! grep -qs "service *= *\"tileception-greetd\"" "$greetd_config" \
        && [ "$(cat "$greetd_pam")" = "$(greetd_pam_text)" ]; then
        $as_root rm -f "$greetd_pam"
    fi
}

if [ -n "${TILECEPTION_SETUP_LIB:-}" ]; then
    return 0
fi
set -eu

# ---------------------------------------------------------------- setup

usage() {
    cat <<'EOF'
Usage: tileception-setup [options]

Chooses which parts of the Tileception desktop to use, and the login screen.
Without options it asks; answers are written to config.toml, where you can
also change them later.

Options:
  --preset <name>          recommended (Tileception's own everything), minimal
                           (no bar, notifications or Doctor), keep (your
                           current settings) or customize
  --greeter <choice>       keep the login screen as it is, use tileception's
                           (installs greetd; affects every desktop's login),
                           or go back to the previous one
  --bar <part>             builtin, none or a command such as waybar
  --bar-position <edge>    top or bottom, for the built-in bar
  --launcher <part>        builtin, none or a command such as fuzzel
  --notifications <part>   builtin, none or the command Super+N runs
  --notification-daemon <command>
                           a notification daemon to start with the session,
                           such as swaync
  --power-menu <part>      builtin, none or a command such as wlogout
  --lock <part>            builtin, none or a command such as
                           "swaylock -f -i {wallpaper}"
  --media <part>           builtin or none
  --doctor <part>          builtin or none
  --handoff <on|off>       share this mouse, keyboard and clipboard with other
                           Tileception computers on the network
  --handoff-passphrase <words>
                           the passphrase they share (implies --handoff on);
                           three random words are chosen when it is missing
  --user <name>            whose config to write (default: you, or SUDO_USER)
  --non-interactive        ask nothing; without a preset, your current
                           settings are kept
  --yes                    skip the confirmation after the summary
  --print-flags            ask, then print the answers as flags instead of
                           applying them (for installers)
  -h, --help               print this help

Examples:
  tileception-setup
  tileception-setup --non-interactive --preset recommended --greeter keep
  tileception-setup --non-interactive --preset minimal --bar waybar
EOF
}

say() { printf '%s\n' "$*" >&2; }
fail() { printf 'tileception-setup: %s\n' "$*" >&2; exit 1; }

# Single-quotes a word for the shell.
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

parts="bar launcher notifications power_menu lock media doctor"

# The value a part has on a fresh install.
default_of() {
    case $1 in
        bar_position) echo top ;;
        *) echo builtin ;;
    esac
}

# Normalized, so builtin/built-in and none/off compare equal.
normal() {
    case $1 in
        "" | builtin | built-in) echo builtin ;;
        none | off) echo none ;;
        *) printf '%s\n' "$1" ;;
    esac
}

preset_value() { # <preset> <part>
    case $1:$2 in
        minimal:bar | minimal:notifications | minimal:doctor) echo none ;;
        recommended:* | minimal:*) echo builtin ;;
    esac
}

part_flag() { printf '%s\n' "--$1" | tr _ -; }

# ------------------------------------------------------------- arguments

interactive=1
print_flags=0
yes=0
preset=""
greeter=""
user=""
notification_daemon=""
want_handoff=""
handoff_passphrase=""
for part in $parts bar_position; do
    eval "want_$part=''"
done

need() { [ "$#" -ge 2 ] && [ -n "$2" ] || fail "$1 needs a value"; }
while [ "$#" -gt 0 ]; do
    case $1 in
        -h | --help) usage; exit 0 ;;
        --non-interactive) interactive=0 ;;
        --yes) yes=1 ;;
        --print-flags) print_flags=1 ;;
        --preset)
            need "$@"
            case $2 in
                recommended | minimal | keep) preset=$2 ;;
                customize | custom) preset=customize ;;
                *) fail "--preset is recommended, minimal, keep or customize, not $2" ;;
            esac
            shift ;;
        --greeter)
            need "$@"
            case $2 in
                keep | tileception | previous) greeter=$2 ;;
                *) fail "--greeter is keep, tileception or previous, not $2" ;;
            esac
            shift ;;
        --user) need "$@"; user=$2; shift ;;
        --handoff)
            need "$@"
            case $2 in on | off) want_handoff=$2 ;; *) fail "--handoff is on or off, not $2" ;; esac
            shift ;;
        --handoff-passphrase)
            need "$@"
            handoff_passphrase=$2
            want_handoff=${want_handoff:-on}
            shift ;;
        --notification-daemon) need "$@"; notification_daemon=$2; shift ;;
        --bar-position)
            need "$@"
            case $2 in top | bottom) want_bar_position=$2 ;; *) fail "--bar-position is top or bottom" ;; esac
            shift ;;
        --media | --doctor)
            need "$@"
            value=$(normal "$2")
            case $value in builtin | none) ;; *) fail "$1 is builtin or none, not $2" ;; esac
            eval "want_${1#--}=\$value"
            shift ;;
        --bar | --launcher | --notifications | --power-menu | --lock)
            need "$@"
            name=$(printf '%s' "${1#--}" | tr - _)
            value=$(normal "$2")
            eval "want_$name=\$value"
            shift ;;
        *) fail "unknown option $1 (see --help)" ;;
    esac
    shift
done

if [ "$interactive" = 1 ] && ! (exec </dev/tty) 2>/dev/null; then
    say "No terminal to ask on, so nothing is asked: your current settings are kept"
    say "unless flags say otherwise (see tileception-setup --help)."
    interactive=0
fi

# ------------------------------------------------------------ whose config

if [ -z "$user" ]; then
    if [ "$(id -u)" -ne 0 ]; then
        user=$(id -un)
    elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        user=$SUDO_USER
    fi
fi

# Settings for root are almost never what is meant: ask whose they are.
if [ -z "$user" ] && [ "$interactive" = 1 ]; then
    say "Which user is Tileception for? (Empty skips the desktop settings.)"
    printf '  User: ' >&2
    read -r user </dev/tty || user=""
fi
if [ -n "$user" ]; then
    getent passwd "$user" >/dev/null || fail "there is no user $user"
fi

config=""
home=""
if [ -n "$user" ]; then
    home=$(getent passwd "$user" | cut -d: -f6)
    if [ "$(id -un)" = "$user" ]; then
        home=${HOME:-$home}
        config="${XDG_CONFIG_HOME:-$home/.config}/tileception/config.toml"
    else
        config="$home/.config/tileception/config.toml"
    fi
fi

# The tileception that reads and writes the config.
tileception_bin=""
for candidate in "${TILECEPTION_BIN:-}" "$(command -v tileception 2>/dev/null || true)" \
    /usr/bin/tileception "${home:-/nonexistent}/.local/bin/tileception" /usr/local/bin/tileception; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        tileception_bin=$candidate
        break
    fi
done

has_config=0
if [ -n "$config" ] && [ -e "$config" ]; then
    has_config=1
fi

# What the config says now, or the default.
current_of() {
    if [ "$has_config" = 1 ] && [ -n "$tileception_bin" ]; then
        if value=$("$tileception_bin" config --file "$config" get "shell.$1" 2>/dev/null); then
            normal "$value"
            return
        fi
    fi
    default_of "$1"
}
for part in $parts bar_position; do
    eval "now_$part=\$(current_of $part)"
done

# A setting as the config has it, or empty.
config_value() {
    if [ "$has_config" = 1 ] && [ -n "$tileception_bin" ]; then
        "$tileception_bin" config --file "$config" get "$1" 2>/dev/null || true
    fi
}
case $(config_value handoff.enabled) in true) now_handoff=on ;; *) now_handoff=off ;; esac
now_passphrase=$(config_value handoff.passphrase)

# ------------------------------------------------------------- questions

# choose <default> <option>...: a numbered menu; sets $choice.
choose() {
    default=$1
    shift
    i=1
    for option in "$@"; do
        printf '  %d) %s\n' "$i" "$option" >&2
        i=$((i + 1))
    done
    while :; do
        printf '  Choice [%s]: ' "$default" >&2
        read -r answer </dev/tty || fail "no answer"
        answer=${answer:-$default}
        case $answer in
            "" | *[!0-9]*) ;;
            *)
                if [ "$answer" -ge 1 ] && [ "$answer" -le "$#" ]; then
                    choice=$answer
                    return
                fi
                ;;
        esac
        say "  Type a number from 1 to $#."
    done
}

# ask_text <prompt> <default>: sets $answer.
ask_text() {
    if [ -n "$2" ]; then
        printf '  %s [%s]: ' "$1" "$2" >&2
    else
        printf '  %s: ' "$1" >&2
    fi
    read -r answer </dev/tty || fail "no answer"
    answer=${answer:-$2}
}

heading() {
    say ""
    say "$*"
}

# ask_part <part> <can-replace> <explanation...>: built-in, off or a command.
ask_part() {
    part=$1
    replace=$2
    shift 2
    eval "now=\$now_$part"
    heading "$(part_name "$part")"
    for line in "$@"; do say "  $line"; done
    case $now in
        builtin) default=1 ;;
        none) default=2 ;;
        *) default=3 ;;
    esac
    if [ "$replace" = 1 ]; then
        choose "$default" "Built-in" "Turned off" "Another program"
    else
        choose "$default" "Built-in" "Turned off"
    fi
    case $choice in
        1) value=builtin ;;
        2) value=none ;;
        3)
            case $now in builtin | none) suggestion="" ;; *) suggestion=$now ;; esac
            answer=""
            while [ -z "$answer" ]; do ask_text "Command" "$suggestion"; done
            value=$answer
            ;;
    esac
    eval "want_$part=\$value"
}

part_name() {
    case $1 in
        bar) echo "Bar" ;;
        bar_position) echo "Bar position" ;;
        launcher) echo "Launcher" ;;
        notifications) echo "Notifications" ;;
        power_menu) echo "Power menu" ;;
        lock) echo "Lock screen" ;;
        media) echo "Volume, brightness and media keys" ;;
        doctor) echo "Doctor" ;;
    esac
}

ask_customize() {
    if [ -z "$want_bar" ]; then
        ask_part bar 1 \
            "Where you are, saved views, the clock and notifications." \
            "Another bar, such as waybar, runs for the whole session; it is stopped" \
            "again when you change this."
    fi
    if [ "$want_bar" = builtin ] && [ -z "$want_bar_position" ]; then
        heading "Bar position"
        case $now_bar_position in bottom) default=2 ;; *) default=1 ;; esac
        choose "$default" "Top" "Bottom"
        case $choice in 1) want_bar_position=top ;; 2) want_bar_position=bottom ;; esac
    fi
    if [ -z "$want_launcher" ]; then
        ask_part launcher 1 \
            "Tap Super to search apps, windows and commands." \
            "Another launcher, such as fuzzel, is started each time you tap Super." \
            "Without the built-in one there is no welcome screen either."
    fi
    if [ -z "$want_notifications" ]; then
        ask_notifications
    fi
    if [ -z "$want_power_menu" ]; then
        ask_part power_menu 1 \
            "Super+X: lock, log out, suspend, restart and power off." \
            "Another power menu, such as wlogout, is started each time it opens."
    fi
    if [ -z "$want_lock" ]; then
        ask_part lock 1 \
            "Super+L, and locking when idle. The built-in one shows the same tiles" \
            "as the login screen. Another locker, such as \"swaylock -f -i {wallpaper}\"," \
            "is started each time the screen locks. Turned off, it never locks."
    fi
    if [ -z "$want_media" ]; then
        ask_part media 0 \
            "Volume, brightness and media keys, with an on-screen display." \
            "Turned off, the keys do nothing until you bind them in [binds]."
    fi
}

ask_notifications() {
    heading "Notifications"
    say "  Popups, and their history with Super+N."
    say "  Another notification daemon, such as swaync, runs for the whole session:"
    say "  it is started with the session, and Super+N runs the command that opens"
    say "  its panel. Turned off, notifications are not shown and Super+N shows only"
    say "  the sound controls."
    case $now_notifications in builtin) default=1 ;; none) default=2 ;; *) default=3 ;; esac
    choose "$default" "Built-in" "Turned off" "Another notification daemon"
    case $choice in
        1) want_notifications=builtin ;;
        2) want_notifications=none ;;
        3)
            answer=""
            while [ -z "$answer" ]; do ask_text "Daemon to start, such as swaync" ""; done
            notification_daemon=$answer
            case $now_notifications in builtin | none) suggestion="" ;; *) suggestion=$now_notifications ;; esac
            ask_text "What Super+N runs, such as swaync-client -t (empty: sound controls)" "$suggestion"
            want_notifications=${answer:-none}
            ;;
    esac
}

ask_doctor() {
    [ -n "$want_doctor" ] && return
    heading "Doctor"
    say "  A panel (Super+/) where an AI agent answers questions about your setup and"
    say "  changes settings for you in plain language. Nothing is set up now: when you"
    say "  first open it, you choose an agent from the ACP Registry and sign in with"
    say "  that agent's provider, which may need an account or an API key and tools"
    say "  such as npx or uvx. It asks before every change until you allow more."
    case $now_doctor in none) default=2 ;; *) default=1 ;; esac
    choose "$default" "Available (choose an agent later)" "Turned off"
    case $choice in 1) want_doctor=builtin ;; 2) want_doctor=none ;; esac
}

ask_handoff() {
    [ -n "$want_handoff" ] && return
    heading "Sharing with other computers"
    say "  Handoff shares one mouse, keyboard and clipboard between Tileception"
    say "  computers on your network: move the pointer past a screen edge to use the"
    say "  computer there. They only connect when they know the same passphrase."
    say "  It listens on TCP port 24850 and finds the others with mDNS (UDP 5353)."
    case $now_handoff in on) default=1 ;; *) default=2 ;; esac
    choose "$default" "On" "Off"
    case $choice in 1) want_handoff=on ;; 2) want_handoff=off ;; esac
    if [ "$want_handoff" = off ] || [ -n "$handoff_passphrase" ]; then
        return
    fi
    say ""
    suggestion=$now_passphrase
    if [ -n "$suggestion" ]; then
        say "  Your current passphrase stays unless you type another."
    elif [ -n "$tileception_bin" ]; then
        suggestion=$("$tileception_bin" config passphrase 2>/dev/null || true)
        say "  Every computer that shares needs the same passphrase. Accept these random"
        say "  words here and type them on the others, or type the passphrase another"
        say "  computer already uses."
    fi
    if [ -z "$suggestion" ]; then
        say "  Every computer that shares needs the same passphrase. Type the one another"
        say "  computer uses, or leave it empty: three random words are chosen while"
        say "  installing and shown at the end."
    fi
    ask_text "Passphrase" "$suggestion"
    handoff_passphrase=$answer
    if [ -n "$handoff_passphrase" ] && [ "${#handoff_passphrase}" -lt 12 ]; then
        say "  That is short: several random words are much harder to guess."
    fi
}

# Whether this system can switch its login screen to greetd.
greeter_possible() {
    [ -d /etc/systemd/system ] && command -v systemctl >/dev/null 2>&1 \
        && { getent passwd "$greeter_user" >/dev/null || command -v apt-get >/dev/null 2>&1; }
}

ask_greeter() {
    [ -n "$greeter" ] && return
    heading "Login screen"
    if ! greeter_possible; then
        say "  Tileception's login screen needs systemd and greetd; neither is set up"
        say "  here, so the current login screen stays."
        greeter=keep
        return
    fi
    if greeter_active; then
        previous=$(cat "$previous_dm_file" 2>/dev/null || true)
        say "  Tileception's login screen is in use."
        if [ -z "$previous" ] && [ -e "$greetd_backup" ]; then
            previous=greetd.service
        fi
        if [ -z "$previous" ]; then
            greeter=keep
            return
        fi
        choose 1 "Keep it" "Go back to ${previous%.service}"
        case $choice in 1) greeter=keep ;; 2) greeter=previous ;; esac
        return
    fi
    now=$(current_dm)
    say "  Tileception has its own login screen: people as tabs, your wallpaper and"
    say "  colours, and every desktop's sessions. It replaces ${now:+${now%.service}, }the login screen"
    say "  for every desktop on this computer, from the next boot (installs greetd)."
    say "  tileception-setup --greeter previous switches back."
    choose 1 "Keep ${now:+${now%.service}, }the current login screen" "Use Tileception's login screen"
    case $choice in 1) greeter=keep ;; 2) greeter=tileception ;; esac
}

if [ "$interactive" = 1 ]; then
    say "Tileception setup"
    if [ "$has_config" = 1 ]; then
        say "Your settings in $config are kept unless you change them here."
    fi
    if [ -z "$preset" ]; then
        heading "How would you like to set up Tileception?"
        if [ "$has_config" = 1 ]; then
            say "  Keep: your current settings, nothing else changes."
        fi
        say "  Recommended: Tileception's own bar, launcher, notifications, lock screen"
        say "  and Doctor."
        say "  Customize: choose each part, or another program in its place."
        say "  Minimal: no bar, notifications or Doctor; Super still opens the launcher"
        say "  and Super+T a terminal."
        if [ "$has_config" = 1 ]; then
            choose 1 "Keep my settings" "Recommended" "Customize" "Minimal"
            case $choice in 1) preset=keep ;; 2) preset=recommended ;; 3) preset=customize ;; 4) preset=minimal ;; esac
        else
            choose 1 "Recommended" "Customize" "Minimal"
            case $choice in 1) preset=recommended ;; 2) preset=customize ;; 3) preset=minimal ;; esac
        fi
    fi
    if [ "$preset" = customize ] && [ -n "$config" ]; then
        ask_customize
        ask_doctor
        ask_handoff
    fi
    if [ "$preset" != minimal ]; then
        ask_greeter
    fi
fi

if [ -z "$preset" ]; then
    if [ "$has_config" = 1 ]; then preset=keep; else preset=recommended; fi
fi
greeter=${greeter:-keep}

# Answers and flags first, then the preset's value, then what is set now.
# Only answers and flags are passed on by --print-flags: the rest is worked
# out again when applying, from the config as it is then.
for part in $parts bar_position; do
    eval "given_$part=\$want_$part"
done
for part in $parts; do
    eval "want=\$want_$part"
    if [ -z "$want" ]; then
        want=$(preset_value "$preset" "$part")
    fi
    if [ -z "$want" ]; then
        eval "want=\$now_$part"
    fi
    eval "want_$part=\$want"
done
want_bar_position=${want_bar_position:-$now_bar_position}
given_handoff=$want_handoff
want_handoff=${want_handoff:-$now_handoff}

# --------------------------------------------------------------- summary

describe() { # <value>
    case $1 in
        builtin) echo "built-in" ;;
        none) echo "off" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

summary() {
    heading "Summary"
    if [ -n "$config" ]; then
        say "  Settings in $config:"
        for part in $parts; do
            eval "want=\$want_$part; now=\$now_$part"
            line="$(part_name "$part"): $(describe "$want")"
            if [ "$part" = bar ] && [ "$want" = builtin ]; then
                line="$line, at the $want_bar_position"
            fi
            if [ "$want" != "$now" ] || { [ "$part" = bar ] && [ "$want_bar_position" != "$now_bar_position" ]; }; then
                line="$line (changed)"
            fi
            say "    $line"
        done
        if [ -n "$notification_daemon" ]; then
            say "    Started with the session: $notification_daemon"
        fi
        if [ "$want_doctor" = builtin ]; then
            say "    Doctor asks which agent to use when you first open it (Super+/)."
        fi
        line="Sharing with other computers: $want_handoff"
        if [ "$want_handoff" = on ]; then
            phrase=${handoff_passphrase:-$now_passphrase}
            if [ -n "$phrase" ]; then
                line="$line, passphrase \"$phrase\""
            else
                line="$line, passphrase chosen while installing"
            fi
        fi
        if [ "$want_handoff" != "$now_handoff" ] || { [ -n "$handoff_passphrase" ] && [ "$handoff_passphrase" != "$now_passphrase" ]; }; then
            line="$line (changed)"
        fi
        say "    $line"
    else
        say "  Desktop settings: skipped (no user)."
    fi
    case $greeter in
        keep) say "  Login screen: unchanged" ;;
        tileception) say "  Login screen: Tileception's, from the next boot (installs greetd)" ;;
        previous) say "  Login screen: back to $(cat "$previous_dm_file" 2>/dev/null || echo the previous one), from the next boot" ;;
    esac
}

if [ "$interactive" = 1 ]; then
    summary
    if [ "$yes" = 0 ]; then
        say ""
        if [ "$print_flags" = 1 ]; then
            printf 'Install with these settings? [Y/n] ' >&2
        else
            printf 'Apply these settings? [Y/n] ' >&2
        fi
        read -r answer </dev/tty || answer=n
        case $answer in
            "" | y | Y | yes | Yes) ;;
            *) fail "cancelled; nothing was changed" ;;
        esac
    fi
fi

# ----------------------------------------------------------------- flags

if [ "$print_flags" = 1 ]; then
    flags="--non-interactive --preset $preset --greeter $greeter"
    if [ -n "$user" ]; then
        flags="$flags --user $(quote "$user")"
    fi
    for part in $parts bar_position; do
        eval "given=\$given_$part"
        if [ -n "$given" ]; then
            flags="$flags $(part_flag "$part") $(quote "$given")"
        fi
    done
    if [ -n "$notification_daemon" ]; then
        flags="$flags --notification-daemon $(quote "$notification_daemon")"
    fi
    if [ -n "$given_handoff" ]; then
        flags="$flags --handoff $given_handoff"
    fi
    if [ -n "$handoff_passphrase" ]; then
        flags="$flags --handoff-passphrase $(quote "$handoff_passphrase")"
    fi
    printf '%s\n' "$flags"
    exit 0
fi

# ----------------------------------------------------------------- apply

# Runs a command as the user whose config this is.
as_user() {
    if [ "$(id -un)" = "$user" ]; then
        "$@"
    else
        $as_root runuser -u "$user" -- "$@"
    fi
}

if [ -n "$config" ]; then
    if [ -z "$tileception_bin" ]; then
        fail "tileception is not installed, so the settings cannot be written"
    fi
    for part in $parts bar_position; do
        eval "want=\$want_$part; now=\$now_$part"
        if [ "$want" != "$now" ]; then
            as_user "$tileception_bin" config --file "$config" set "shell.$part" "$want"
            say "Set shell.$part to $(describe "$want")"
        fi
    done
    if [ -n "$notification_daemon" ]; then
        as_user "$tileception_bin" config --file "$config" add general.autostart "$notification_daemon"
        say "$notification_daemon starts with the session"
    fi
    if [ "$want_handoff" = on ]; then
        handoff_passphrase=${handoff_passphrase:-$now_passphrase}
        if [ -z "$handoff_passphrase" ]; then
            handoff_passphrase=$("$tileception_bin" config passphrase) || fail "could not choose a passphrase"
        fi
        if [ "$handoff_passphrase" != "$now_passphrase" ]; then
            as_user "$tileception_bin" config --file "$config" set handoff.passphrase "$handoff_passphrase"
            say "Set the handoff passphrase"
        fi
        if [ "$now_handoff" != on ]; then
            as_user "$tileception_bin" config --file "$config" set handoff.enabled true
            say "Turned handoff on"
        fi
    elif [ "$now_handoff" = on ]; then
        as_user "$tileception_bin" config --file "$config" set handoff.enabled false
        say "Turned handoff off"
    fi
fi

case $greeter in
    tileception) enable_greeter ;;
    previous) restore_login_screen ;;
esac

say ""
say "Done."
if [ "$greeter" = tileception ]; then
    say "Reboot, and log in on Tileception's login screen."
else
    say "Log out (or reboot), then choose Tileception on the login screen."
fi
say "Super opens the launcher, Super+T a terminal."
if [ -n "$config" ] && [ "$want_handoff" = on ]; then
    say "Handoff passphrase: $handoff_passphrase"
    say "On each other computer, run: tileception pair $handoff_passphrase"
    say "tileception pair shows it again; Ctrl+Super+Escape brings input back."
fi
say "To change these choices later, run tileception setup again,"
if [ -n "$config" ]; then
    say "or edit $config (a running session applies it on save)."
fi
