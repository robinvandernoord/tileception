#!/bin/sh
# Starts Tileception as a login session. The display manager runs this through
# the Tileception entry in /usr/share/wayland-sessions.

# Give every application the same agent, and stop it when the session exits.
# Keep an agent supplied by the login environment, if there is one.
if [ -z "$SSH_AUTH_SOCK" ] && command -v ssh-agent >/dev/null 2>&1; then
    export TILECEPTION_OWN_AGENT=1
    exec ssh-agent "$0" "$@"
fi

# That agent listens at a random path under /tmp, new at every login. What
# outlives the session (a tmux server, a systemd user service) would keep the
# old one, and a program that wants the path written down could not be told
# once. So applications get a path that stays the same, linked to this
# login's agent. The agent keeps its own socket: the one from the login
# before lingers a few seconds and then removes what it listened on.
if [ -n "$TILECEPTION_OWN_AGENT" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    link="$XDG_RUNTIME_DIR/tileception-ssh-agent.sock"
    ln -sfn "$SSH_AUTH_SOCK" "$link" 2>/dev/null && export SSH_AUTH_SOCK="$link"
fi
unset TILECEPTION_OWN_AGENT

# Cursor theme from the desktop settings, when there are any. GNOME's first:
# GTK applications read that one, so every window shows the same pointer.
if [ -z "${XCURSOR_THEME}" ] && command -v gsettings >/dev/null 2>&1; then
    for schema in org.gnome.desktop.interface org.cinnamon.desktop.interface; do
        theme=$(gsettings get "$schema" cursor-theme 2>/dev/null | tr -d "'")
        size=$(gsettings get "$schema" cursor-size 2>/dev/null)
        if [ -n "$theme" ]; then
            export XCURSOR_THEME="$theme"
            [ -n "$size" ] && export XCURSOR_SIZE="$size"
            break
        fi
    done
fi

# The helpers (tileception-power) live next to this script.
case ":$PATH:" in
    *":$(dirname "$0"):"*) ;;
    *) export PATH="$(dirname "$0"):$PATH" ;;
esac

# Fastfetch shows Tileception's logo for anyone without a fastfetch config of
# their own. Its config is installed with the session (share/tileception/xdg
# next to this script's bin), so nothing is written to ~/.config.
xdg="$(dirname "$0")/../share/tileception/xdg"
if [ -d "$xdg" ]; then
    xdg=$(cd "$xdg" && pwd)
    case ":$XDG_CONFIG_DIRS:" in
        *":$xdg:"*) ;;
        *) export XDG_CONFIG_DIRS="$xdg:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
    esac
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Tileception
export XDG_SESSION_DESKTOP=tileception
# Chromium and Electron keep secrets in plain text on desktops they do not
# know, and some (Signal) then refuse to open data set up under GNOME. They
# check this old variable only when XDG_CURRENT_DESKTOP names nothing they
# know, so it picks the Secret Service without changing anything else.
export GNOME_DESKTOP_SESSION_ID=this-is-deprecated
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"
export _JAVA_AWT_WM_NONREPARENTING=1

# NVIDIA's proprietary driver: GBM and GLX through the NVIDIA libraries.
if [ -d /sys/module/nvidia_drm ]; then
    export GBM_BACKEND=nvidia-drm
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export LIBVA_DRIVER_NAME=nvidia
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/tileception"
mkdir -p "$state"
[ -f "$state/tileception.log" ] && mv -f "$state/tileception.log" "$state/tileception.log.old"

export RUST_LOG="${RUST_LOG:-warn,tileception=info,smithay=warn}"
exec "$(dirname "$0")/tileception" --session >"$state/tileception.log" 2>&1
