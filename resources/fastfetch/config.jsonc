// Fastfetch's config in a Tileception session, when you have none of your own
// in ~/.config/fastfetch. tileception-session puts this file's directory in
// XDG_CONFIG_DIRS; other sessions keep fastfetch's defaults.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // fastfetch/logos/tileception in a data directory, such as /usr/share.
        // Without an extension, so `fastfetch -l tileception` finds it too.
        "source": "tileception",
        // A text logo. Left to detect it, fastfetch in kitty tries the file
        // as an image and then waits forever for the terminal's reply.
        "type": "file",
        "color": {
            // The pale tiles take the terminal's text colour, so they show on
            // light and dark themes alike.
            "1": "default",
            "2": "#d42a1e",
            "3": "#f4c22f",
            "4": "#1d4fa2"
        }
    },
    "display": {
        "color": {
            "keys": "#d42a1e",
            "title": "#d42a1e"
        }
    },
    // Fastfetch's default modules (`fastfetch --gen-config`): a config without
    // this list shows the logo and nothing else.
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
