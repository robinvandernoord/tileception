# tileception.space on OVH web hosting (Apache). Deployed by .github/workflows/website.yml.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

AddType font/woff2 .woff2
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

# /install is a shell script meant for `curl | sh`; serve it as plain text.
<Files "install">
  ForceType "text/plain; charset=utf-8"
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One canonical origin: https, no www.
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://tileception.space%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
